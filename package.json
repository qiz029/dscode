    "publish:token": "node scripts/npm-token.mjs",
    "test:unit": "node scripts/checks.mjs unit",
    "test:integration": "node scripts/checks.mjs integration",
    "test:package": "node scripts/checks.mjs package",
    "test:coverage": "node scripts/checks.mjs coverage",
    "typecheck": "tsc -p packages/tui/tsconfig.json",
    "typecheck:strict": "tsc -p packages/tui/tsconfig.strict.json",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm run typecheck:strict && npm run test:coverage && npm run test:integration && npm run test:package && npm run test:eval",
    "test:eval": "node --test eval/compaction/tests/*.test.mjs eval/continuation/tests/*.test.mjs eval/deepswe/tests/*.test.mjs",
