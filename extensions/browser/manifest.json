{
  "manifest_version": 3,
  "name": "DSCODE Browser",
  "version": "0.1.0",
  "description": "Share selected browser tabs with your local DSCODE session.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
